---
// The eight mask patterns (ISO/IEC 18004, Table 10 and Figure 21), drawn on a version 1 code at build time.
import katex from 'katex';
import { fixedLayout } from '../../lib/qr/layout';
import { MASK_CONDITIONS, MASK_FORMULAS } from '../../lib/qr/masks';

const { size, roles } = fixedLayout(1);
const masks = MASK_CONDITIONS.map((condition, mask) => {
  let dark = '';
  let fixed = '';
  for (let i = 0; i < size; i++) {
    for (let j = 0; j < size; j++) {
      const cell = `M${j} ${i}h1v1h-1z`;
      if (roles[i * size + j] !== 'data') fixed += cell;
      else if (condition(i, j)) dark += cell;
    }
  }
  return {
    bits: mask.toString(2).padStart(3, '0'),
    dark,
    fixed,
    formula: katex.renderToString(MASK_FORMULAS[mask], { output: 'htmlAndMathml' }),
  };
});
---

<figure class="mask-patterns">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Pattern</th>
          <th>Reference</th>
          <th>Flip the module in row <i>i</i>, column <i>j</i> when</th>
        </tr>
      </thead>
      <tbody>
        {
          masks.map((m) => (
            <tr>
              <td>
                <svg viewBox={`-1 -1 ${size + 2} ${size + 2}`} role="img" aria-label={`Mask pattern ${m.bits} on a version 1 code`}>
                  <rect x="-1" y="-1" width={size + 2} height={size + 2} fill="#ffffff" />
                  <path d={m.fixed} fill="#d9d8d2" />
                  <path d={m.dark} fill="#1c1b19" />
                </svg>
              </td>
              <td>
                <code>{m.bits}</code>
              </td>
              <td class="formula" set:html={m.formula} />
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <figcaption>
    The eight mask patterns on a version 1 code. Dark modules are the ones the mask flips. Grey modules are the fixed
    parts and the format information, which are never masked.
  </figcaption>
</figure>

<style>
  .mask-patterns {
    margin: 2rem 0;
  }

  .table-wrap {
    margin: 0;
  }

  td {
    vertical-align: middle !important;
  }

  svg {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 3px;
  }

  .formula {
    white-space: nowrap;
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
