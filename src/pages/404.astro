---
// GitHub Pages serves this for any address on the site that doesn't exist, so every link here is absolute.
import Base from '../layouts/Base.astro';
import ChapterList from '../components/ChapterList.astro';
---

<Base title="Page not found" description="There is no page at this address.">
  <h1>Page not found</h1>
  <p>There's no page at this address. The link may be mistyped, or the page may have moved. Here are all the chapters:</p>
  <ChapterList />
</Base>
